{% comment %}
  FAQ source priority:
  1. Product metafield (list of `faq_item` metaobjects with `question` + `answer`),
     key configurable in the section settings (default: custom.faq)
  2. Section blocks (question + answer)
{% endcomment %}

{{ 'knr-faq.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign faq_items = blank
  if product and section.settings.metafield != blank
    assign metafield_parts = section.settings.metafield | split: '.'
    assign faq_items = product.metafields[metafield_parts[0]][metafield_parts[1]].value
  endif
-%}

<section class="knr-section knr-faq" aria-labelledby="KnrFaq-{{ section.id }}">
  <div class="knr-faq__inner knr-container">
    <h2 id="KnrFaq-{{ section.id }}" class="knr-faq__heading">{{ section.settings.heading | escape }}</h2>

    <div class="knr-faq__list">
      {%- if faq_items.size > 0 -%}
        {%- for item in faq_items -%}
          <details class="knr-accordion knr-faq__item"{% if forloop.first and section.settings.open_first %} open{% endif %}>
            <summary>
              <h3 class="knr-faq__question">{{ item.question.value | escape }}</h3>
              {%- render 'knr-icon', icon: 'chevron-down', class: 'knr-accordion__icon' -%}
            </summary>
            <div class="knr-faq__answer knr-rte">{{ item.answer | metafield_tag }}</div>
          </details>
        {%- endfor -%}
      {%- else -%}
        {%- for block in section.blocks -%}
          <details
            class="knr-accordion knr-faq__item"
            {% if forloop.first and section.settings.open_first %}
              open
            {% endif %}
            {{ block.shopify_attributes }}
          >
            <summary>
              <h3 class="knr-faq__question">{{ block.settings.question | escape }}</h3>
              {%- render 'knr-icon', icon: 'chevron-down', class: 'knr-accordion__icon' -%}
            </summary>
            <div class="knr-faq__answer knr-rte">{{ block.settings.answer }}</div>
          </details>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "KNR · FAQ",
  "tag": "div",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Questions fréquentes"
    },
    {
      "type": "text",
      "id": "metafield",
      "label": "Product metafield (namespace.key)",
      "info": "List of FAQ metaobjects (fields: question, answer). When empty, the blocks below are used.",
      "default": "custom.faq"
    },
    {
      "type": "checkbox",
      "id": "open_first",
      "label": "Open first question",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Comment utiliser ?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Appliquez 3 à 5 gouttes le soir sur visage et cou préalablement nettoyés.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "KNR · FAQ",
      "blocks": [{ "type": "question" }, { "type": "question" }, { "type": "question" }]
    }
  ]
}
{% endschema %}
