{% comment %}
  Inline SVG icons used by the knr- sections. All icons use currentColor.

  Accepts:
  - icon: {String} icon name
  - class: {String} optional class

  Usage:
  {% render 'knr-icon', icon: 'chevron-down', class: 'knr-accordion__icon' %}
{% endcomment %}
{%- case icon -%}
  {%- when 'chevron-down' -%}
    <svg class="{{ class }}" aria-hidden="true" focusable="false" width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.6"/></svg>
  {%- when 'chevron-left' -%}
    <svg class="{{ class }}" aria-hidden="true" focusable="false" width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M8 2L4 6l4 4" stroke="currentColor" stroke-width="1.6"/></svg>
  {%- when 'chevron-right' -%}
    <svg class="{{ class }}" aria-hidden="true" focusable="false" width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M4 2l4 4-4 4" stroke="currentColor" stroke-width="1.6"/></svg>
  {%- when 'plus' -%}
    <svg class="{{ class }}" aria-hidden="true" focusable="false" width="10" height="10" viewBox="0 0 10 10" fill="none"><path d="M5 0v10M0 5h10" stroke="currentColor" stroke-width="1.2"/></svg>
  {%- when 'star' -%}
    <svg class="{{ class }}" aria-hidden="true" focusable="false" width="10" height="10" viewBox="0 0 24 24"><path fill="currentColor" d="M12 1.8l3.1 6.6 7.2.9-5.3 5 1.4 7.1L12 17.9l-6.4 3.5L7 14.3 1.7 9.3l7.2-.9z"/></svg>
  {%- when 'star-outline' -%}
    <svg class="{{ class }}" aria-hidden="true" focusable="false" width="10" height="10" viewBox="0 0 24 24"><path fill="none" stroke="currentColor" stroke-width="1.8" d="M12 3.9l2.5 5.3 5.8.7-4.3 4 1.1 5.8L12 16.9l-5.1 2.8L8 13.9 3.7 9.9l5.8-.7z"/></svg>
  {%- when 'filter' -%}
    <svg class="{{ class }}" aria-hidden="true" focusable="false" width="18" height="18" viewBox="0 0 18 18" fill="none"><path d="M2 4.5h14M4.5 9h9M7 13.5h4" stroke="currentColor" stroke-width="1.2"/></svg>
  {%- when 'grip' -%}
    <svg class="{{ class }}" aria-hidden="true" focusable="false" width="14" height="12" viewBox="0 0 14 12" fill="none"><path d="M2 0v12M7 0v12M12 0v12" stroke="currentColor" stroke-width="1.6"/></svg>
  {%- when 'pin' -%}
    <svg class="{{ class }}" aria-hidden="true" focusable="false" width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M10 18s6-5.2 6-10A6 6 0 0 0 4 8c0 4.8 6 10 6 10z" stroke="currentColor" stroke-width="1.3"/><circle cx="10" cy="8" r="2.2" stroke="currentColor" stroke-width="1.3"/></svg>
  {%- when 'facebook' -%}
    <svg class="{{ class }}" aria-hidden="true" focusable="false" width="18" height="18" viewBox="0 0 24 24"><path fill="currentColor" d="M24 12.07C24 5.4 18.63 0 12 0S0 5.4 0 12.07C0 18.1 4.39 23.1 10.13 24v-8.44H7.08v-3.49h3.04V9.41c0-3.02 1.8-4.7 4.54-4.7 1.31 0 2.68.24 2.68.24v2.97h-1.5c-1.5 0-1.96.93-1.96 1.89v2.26h3.33l-.53 3.5h-2.8V24C19.62 23.1 24 18.1 24 12.07z"/></svg>
  {%- when 'instagram' -%}
    <svg class="{{ class }}" aria-hidden="true" focusable="false" width="18" height="18" viewBox="0 0 24 24" fill="none"><rect x="2" y="2" width="20" height="20" rx="5.5" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="12" r="4.6" stroke="currentColor" stroke-width="2"/><circle cx="17.6" cy="6.4" r="1.3" fill="currentColor"/></svg>
  {%- when 'tiktok' -%}
    <svg class="{{ class }}" aria-hidden="true" focusable="false" width="18" height="18" viewBox="0 0 24 24"><path fill="currentColor" d="M16.6 0h-4v16.3a3.4 3.4 0 1 1-3.4-3.4c.35 0 .69.05 1 .15V8.96a7.5 7.5 0 1 0 6.4 7.42V8.2A9.6 9.6 0 0 0 22 9.9V5.9A5.4 5.4 0 0 1 16.6 0z"/></svg>
  {%- when 'linkedin' -%}
    <svg class="{{ class }}" aria-hidden="true" focusable="false" width="18" height="18" viewBox="0 0 24 24"><path fill="currentColor" d="M1 8h4.6v15H1zM3.3 1a2.65 2.65 0 1 1 0 5.3 2.65 2.65 0 0 1 0-5.3zM8.5 8h4.4v2.05h.06c.61-1.16 2.1-2.38 4.33-2.38 4.63 0 5.48 3.05 5.48 7V23h-4.57v-7.28c0-1.74-.03-3.97-2.42-3.97-2.42 0-2.79 1.89-2.79 3.85V23H8.5z"/></svg>
{%- endcase -%}
