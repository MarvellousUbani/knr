{% comment %}
  Icons for the KNR cart drawer (currentColor).

  Accepts:
  - icon: {String} bag | close | minus | plus | back | truck | sample | gift
{% endcomment %}
{%- case icon -%}
  {%- when 'bag' -%}
    <svg aria-hidden="true" focusable="false" width="22" height="22" viewBox="0 0 22 22" fill="none"><path d="M4.5 8.5h13l-1 11h-11l-1-11z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/><path d="M8 8.5V6.5a3 3 0 0 1 6 0v2" stroke="currentColor" stroke-width="1.3"/></svg>
  {%- when 'close' -%}
    <svg aria-hidden="true" focusable="false" width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M1 1l12 12M13 1L1 13" stroke="currentColor" stroke-width="1.4"/></svg>
  {%- when 'minus' -%}
    <svg aria-hidden="true" focusable="false" width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M1 6h10" stroke="currentColor" stroke-width="1.2"/></svg>
  {%- when 'plus' -%}
    <svg aria-hidden="true" focusable="false" width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M6 1v10M1 6h10" stroke="currentColor" stroke-width="1.2"/></svg>
  {%- when 'back' -%}
    <svg aria-hidden="true" focusable="false" width="16" height="12" viewBox="0 0 16 12" fill="none"><path d="M6 1L1 6l5 5M1 6h14" stroke="currentColor" stroke-width="1.4"/></svg>
  {%- when 'truck' -%}
    <svg aria-hidden="true" focusable="false" width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M1.5 4h8v7h-8zM9.5 6.5h2.6l2.4 2.6V11h-5" stroke="currentColor" stroke-width="1.1" stroke-linejoin="round"/><circle cx="4.5" cy="11.5" r="1.3" fill="#fff" stroke="currentColor" stroke-width="1.1"/><circle cx="11.5" cy="11.5" r="1.3" fill="#fff" stroke="currentColor" stroke-width="1.1"/></svg>
  {%- when 'sample' -%}
    <svg aria-hidden="true" focusable="false" width="16" height="16" viewBox="0 0 16 16" fill="none"><rect x="2.5" y="2.5" width="11" height="11" rx="2.5" stroke="currentColor" stroke-width="1.1" stroke-dasharray="2 1.6"/></svg>
  {%- when 'gift' -%}
    <svg aria-hidden="true" focusable="false" width="16" height="16" viewBox="0 0 16 16" fill="none"><rect x="2" y="6" width="12" height="8" stroke="currentColor" stroke-width="1.1"/><path d="M1.5 4h13v2h-13zM8 4v10M8 4C6.5 1.5 4.5 2 5 3.3 5.4 4 8 4 8 4zM8 4c1.5-2.5 3.5-2 3-.7C10.6 4 8 4 8 4z" stroke="currentColor" stroke-width="1.1" stroke-linejoin="round"/></svg>
{%- endcase -%}
